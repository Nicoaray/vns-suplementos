# Copiar este archivo como ".env" y completar los valores reales.
# NUNCA subir el archivo ".env" real a un repositorio publico.

DATABASE_URL=postgresql://vns_user:vns_password@localhost:5432/vns_suplementos

# Generar uno propio y secreto, por ejemplo con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambiar-esta-clave-por-una-generada-de-forma-segura
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Origenes permitidos para CORS, separados por coma
BACKEND_CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# "development" o "production". En production se ocultan /docs y /redoc.
ENVIRONMENT=development
